<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext (HTTP) traffic for Music Assistant servers.
        Many users run MA on local networks via IP address without HTTPS
        (e.g., http://192.168.1.50:8095). Android's domain-config cannot
        match IP ranges, so we must allow cleartext globally.
        HTTPS is supported and recommended for remote access.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
